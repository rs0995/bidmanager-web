# Copy to .env on the VM and fill in. .env and drive-sa.json are git-ignored.

# Public hostname. Create an A record pointing this name to the OCI VM's reserved
# public IP. If you have no domain yet, use <public-ip>.sslip.io as an interim so
# Caddy can still issue real HTTPS (it is pinned to the IP — replace it later).
BIDMANAGER_DOMAIN=api.example.com

# Browser origins allowed by CORS (comma-separated). Keep bidmanager://app for the
# Electron clients; add any hosted admin-console origin.
BIDMANAGER_CORS_ORIGINS=bidmanager://app

# OCI metadata shown by the Server UI (Server tab label + console link).
OCI_REGION=ap-mumbai-1
OCI_INSTANCE_ID=replace-with-oci-instance-ocid

# External Neon Postgres connection string (project region: Singapore / ap-southeast-1
# as of 2026-08-28). Nothing self-hosted; no Postgres container runs in this stack.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Google Drive — SAME folder ID as Cloud Run. Auth is the JSON key you place next
# to this file as ./drive-sa.json (mounted read-only into the backend container).
GOOGLE_DRIVE_FOLDER_ID=1mZkHxslSqZ4BpGpKjLYS2Y--N7MvF03K

# Carry these THREE over verbatim from GCP Secret Manager. Changing ADMIN_API_KEY
# or BIDMANAGER_DOWNLOAD_TOKEN_SECRET invalidates issued admin keys / signed
# download links. (Generate fresh only for a brand-new deployment: openssl rand -hex 32)
ADMIN_API_KEY=carry-over-from-bidmanager-admin-api-key
BIDMANAGER_CLIENT_API_KEY=carry-over-from-bidmanager-client-api-key
BIDMANAGER_DOWNLOAD_TOKEN_SECRET=carry-over-from-bidmanager-download-token-secret

# Optional Gemini key used for CAPTCHA assistance.
GOOGLE_API_KEY=

# Optional comma-separated proxies used by scraper jobs.
BIDMANAGER_PROXY_URLS=
