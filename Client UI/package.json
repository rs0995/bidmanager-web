{
  "name": "bidmanager-client-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first BidManager client for desktop and web",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --host localhost --port 3000 --strictPort\" \"wait-on http-get://localhost:3000 && cross-env ELECTRON_DEV=1 ELECTRON_RENDERER_URL=http://localhost:3000 electron .\"",
    "desktop:dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.bidmanager.client",
    "productName": "BidManager Client",
    "directories": { "output": "dist-electron" },
    "files": ["electron/**/*", "package.json"],
    "extraResources": [{ "from": "dist", "to": "client/dist" }],
    "win": {
      "target": ["nsis"],
      "artifactName": "BidManager-Client-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
