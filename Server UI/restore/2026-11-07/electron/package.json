{
  "name": "bidmanager-control-shell",
  "version": "1.0.18",
  "private": true,
  "description": "Electron wrapper for the BidManager Control admin console",
  "main": "main.cjs",
  "scripts": {
    "electron:dev": "concurrently -k \"npm --prefix .. run dev\" \"wait-on http-get://127.0.0.1:5174 && cross-env ELECTRON_DEV=1 ELECTRON_RENDERER_URL=http://127.0.0.1:5174 BIDMANAGER_PORT=8090 electron .\"",
    "electron:dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "cross-env": "7.0.3",
    "electron": "33.4.11",
    "electron-builder": "26.8.1",
    "wait-on": "8.0.5"
  },
  "build": {
    "appId": "com.bidmanager.control",
    "productName": "BidManager Control",
    "electronVersion": "33.4.11",
    "icon": "assets/icon.png",
    "directories": {
      "output": "../installer/current"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "frontend/dist"
      },
      {
        "from": "../build/admin-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "BidManagerControl-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true
    }
  }
}
